# Plantilla de configuración de ms-helix-mep. Copiar a `.env` en cada
# carpeta de organización y completar los valores reales -- `.env` NO se
# trackea en git (ver .gitignore); esta plantilla sí.

## --- Específico de cada organización (obligatorio, sin default) ---

# Identificador corto de esta organización (minúsculas, sin espacios).
# docker-compose.yml lo usa para nombrar contenedores: mongodb-helix-<org>,
# redis-helix-<org>, ms-helix-<org>. Debe ser único por organización en
# este host -- es lo único que evita choques de nombre entre carpetas.
ORG_SLUG=

# Conexión a MongoDB. El nombre del servicio Mongo dentro de la red de
# docker-compose es fijo ("mongodb-helix"), no depende de ORG_SLUG:
# mongodb://andrair:1234@mongodb-helix:27017/ms_helix_<org>?authSource=admin
MONGO_DB=

# Puerto HTTP donde escucha esta instancia -- también se usa para publicar
# el puerto al host en docker-compose.yml (misma variable en ambos lados,
# no hace falta mantenerlos sincronizados a mano)
HTTP_PORT=

# Puertos publicados al host para acceso directo a Mongo/Redis desde fuera
# del contenedor (debugging). Deben ser únicos por organización en este
# host -- todas las organizaciones comparten el mismo host físico.
MONGO_LOCAL_PORT=
REDIS_LOCAL_PORT=

# Nombre REAL del volumen de Docker donde vive la base de esta
# organización -- OBLIGATORIO, sin default seguro posible. Verificar con
# `docker volume ls | grep <org>` el nombre exacto que YA existe antes de
# levantar; si se pone un nombre que no existe, Docker crea uno nuevo
# vacío en su lugar (sin avisar) -- exactamente el incidente de datos del
# 2026-08-24, dos veces en el mismo día. Ante la duda, confirmarlo con
# `docker volume ls` primero, nunca adivinarlo.
MONGO_VOLUME_NAME=

# Organización de Meraki
ORGANIZATION_ID=
ORGANIZATION_NAME=

# Token de la API de Meraki para ESTA organización (cada organización debe
# tener su propio token -- no reutilizar entre organizaciones)
TOKEN_CISCO=

# GLPI de esta organización
URL_GLPI=
APP_TOKEN_GLPI=
AUTHORIZATION_GLPI=

# ms-helix-tcp de esta organización (destino de los envíos al NMS Helix)
URL_TCP_SERVER=

## --- Campos fijos del envío a Helix (rara vez cambian por organización) ---

TIPO_ALERTA="ALARMA"
FASE_ALERTA="FASE1"

## --- Gateway de rate-limit hacia Meraki (BullMQ) -- Fase D ---

# Redis PROPIO de esta organización -- no compartir entre organizaciones.
# En docker-compose esto lo sobreescribe la variable `environment:` del
# servicio ms-helix (ver docker-compose.yml), así que este valor solo
# aplica corriendo local sin Docker (npm start). dotenv NO interpola
# variables entre sí -- escribir el puerto real, no una referencia a
# REDIS_LOCAL_PORT:
REDIS_URL=redis://localhost:6380

# Espaciado mínimo entre llamadas reales a Meraki. 11000 (11s) es el valor
# validado empíricamente en mep3 -- ver 01_FIX_ALERTAS_RETENIDAS...md
# sección D.0: además del límite de 10 req/s por organización, Meraki
# aplica 100 req/s por IP de origen COMPARTIDO entre todas las
# organizaciones que salgan por esa IP. Si varias organizaciones corren en
# el mismo host, todas deben tener un valor conservador acá.
MERAKI_RATE_DELAY_MS=11000

# Cuánto espera el productor a que el worker resuelva un job antes de
# darlo por perdido (ms). Default generoso a propósito -- ver meraki.queue.ts
#MERAKI_JOB_WAIT_TIMEOUT_MS=600000

# Reintentos ante 429 dentro del worker, respetando Retry-After
#CISCO_429_MAX_RETRIES=5
#CISCO_429_DEFAULT_RETRY_SEC=10

# Dashboard /admin/queues (bull-board). Si se dejan vacías, la ruta
# responde 503 en vez de quedar sin autenticación (fail-closed).
BULLBOARD_USER=
BULLBOARD_PASSWORD=

## --- Paginación de active/cese (rara vez hace falta tocar) ---

#CISCO_PAGE_DELAY_MS=5000
#CISCO_MAX_ALERTS=10000
#CISCO_MAX_PAGES=20

## --- Apagar polling contra Meraki sin parar el contenedor (desarrollo/pruebas) ---
## Pensado para cuando el .env tiene credenciales REALES de producción pero
## se quiere probar algo local (ej. el webhook receptor, Fase C) sin que
## esta instancia compita por el rate-limit compartido con la instancia
## real. Default true en ambos -- no cambia nada en producción a menos que
## se seteen explícitamente en false.

#ACTIVE_ENABLED=true
#CESE_ENABLED=true

## Limitar el polling a ciertos tipos de alerta de Assurance (lista separada
## por comas; sin definir = todos). Sirve cuando un tipo (ej. `unreachable`)
## ya llega por webhook y solo falta pedir el resto por polling. Cada tipo
## debe existir en el manual (alarmmanuals).
#CISCO_ACTIVE_TYPES=crc_errors,dns_down,ip_conflict,ethernet_negotiation_failure,fan_down,udld_err_unidir,mps_down
#CISCO_CESE_TYPES=

## --- Reconciliación periódica (cron interno, Fase B1/B5) ---

#RECONCILIATION_ENABLED=true
#RECONCILIATION_CRON="7 * * * *"
#RECONCILIATION_MAX_AGE_DAYS=30
#RECONCILIATION_RATE_DELAY_MS=11000
#RECONCILIATION_STUCK_HOURS=1
#RECONCILIATION_MAX_NETWORKS=999
#RECONCILIATION_MAX_PAGES_PER_NETWORK=8
#RECONCILIATION_DRY_RUN=false

## Segunda pasada por lookup individual (GET assurance/alerts/{id}), dentro
## del mismo cron -- para alertas atascadas que el escaneo por lista de
## arriba no pudo resolver (típicamente por rotación de id en Meraki). SIN
## el límite de RECONCILIATION_MAX_AGE_DAYS -- ese límite es por la
## paginación de la lista, que este camino no usa (consulta el id directo).
## Si Meraki confirma cese -> resuelve con la fecha real. Si Meraki ya no
## tiene el id (404) -> resuelve con la fecha de detección (no la real, que
## no se puede saber) y un resolvedVia distinto para dejarlo trazable.
#RECONCILIATION_FORCE_LOOKUP_ENABLED=true
#RECONCILIATION_FORCE_LOOKUP_STUCK_DAYS=2
#RECONCILIATION_FORCE_LOOKUP_MAX_PER_RUN=100

## --- Limpieza de alertas huérfanas por reemplazo de hardware (RMA) ---
## No llama a Meraki (puramente local) -- caso real: al reemplazar un
## equipo, el viejo queda "estacionado" en una red de tránsito (ej.
## SAMEP-PRUEBAS-RMA) y su alerta nunca se cierra a mano; como el equipo
## viejo sigue genuinamente desconectado, ni el lookup individual de arriba
## la puede cerrar (Meraki confirma "sigue activa" correctamente). Esto
## cierra esas alertas por patrón de nombre de red, no por estado real.
## STALE_ALERT_NETWORK_PATTERNS: nombres de red que indican "no es una
## escuela real" (coincidencia parcial, sin distinguir mayúsculas).
#STALE_ALERT_CLEANUP_ENABLED=true
#STALE_ALERT_CLEANUP_CRON="30 */6 * * *"
#STALE_ALERT_CLEANUP_MIN_DAYS=2
#STALE_ALERT_NETWORK_PATTERNS="PRUEBAS,RMA"

## --- Backfill único del histórico atascado (Fase E, script standalone) ---
## No las lee el cron normal -- solo `npm run backfill:reconciliation`
## (src/scripts/backfillReconciliation.ts). Requiere que el contenedor ya
## esté corriendo (usa el Worker de meraki.queue que ya vive ahí).

#BACKFILL_MAX_AGE_DAYS=3650
#BACKFILL_DRY_RUN=true

## --- Webhook de Meraki (Fase C, en construcción) ---
## Receptor en POST /webhooks/meraki/alerts. El shared secret viaja DENTRO
## del body JSON que manda Meraki (campo `sharedSecret`), no como header --
## debe coincidir con el que se configure en Meraki al registrar el HTTP
## server receptor. Sin esta variable, el endpoint responde 503 (fail closed).

#MERAKI_WEBHOOK_SHARED_SECRET=
#MERAKI_WEBHOOK_RECEIVER_URL="https://pbscatalyst.ice.go.cr/webhooks/meraki/alerts"
#WEBHOOK_ALERTS_CONCURRENCY=3

## Verificación por red disparada por webhook (solo para la instancia -wh).
## Cada `stopped_reporting` agenda una consulta a la API de Meraki pasado el
## umbral, para traer la alerta real de Assurance (con equipo e id de la API).
## La consulta va por el gateway con rate-limit (meraki.queue.ts), una sola
## por red dentro de la ventana de agrupación.
#WEBHOOK_VERIFY_ENABLED=false
#WEBHOOK_VERIFY_DELAY_MS=900000
#WEBHOOK_VERIFY_COALESCE_MS=300000
## Reintentos de las verificaciones cuando la API responde 429 (límite de 1
## petición cada 10 s por organización, compartido con el polling de producción).
#WEBHOOK_VERIFY_ATTEMPTS=5
#WEBHOOK_VERIFY_BACKOFF_MS=60000
## Cese: cada `started_reporting` agenda un cierre de las alertas abiertas de
## esa red (solo consulta a Meraki si en Mongo hay algo abierto). El candado
## debe ser más corto que el retraso.
#WEBHOOK_VERIFY_CESE_DELAY_MS=180000
#WEBHOOK_VERIFY_CESE_COALESCE_MS=60000
## Barrido de respaldo de ceses: cada 10 min mira UNA lista de resueltas de la
## organización y cierra las alertas abiertas que ya están resueltas en Meraki
## (no depende de los avisos). Sin alertas abiertas no consulta nada.
#WEBHOOK_VERIFY_SWEEP_CRON="*/10 * * * *"
#WEBHOOK_VERIFY_SWEEP_MAX_PAGES=3
## Además de cerrar, el barrido guarda alertas ya resueltas que nunca se
## guardaron, pero solo de redes con un stopped_reporting en las últimas N horas.
#WEBHOOK_VERIFY_SWEEP_LOOKBACK_MS=10800000
## Tope de antigüedad que un barrido mira hacia atrás (default 24 h), aunque
## haya alertas abiertas más viejas.
#WEBHOOK_VERIFY_SWEEP_MAX_AGE_MS=86400000
## Barrido de alertas ACTIVAS de la organización (garantía de cobertura: Meraki
## no envía webhook para todos los cortes, p.ej. un solo AP). Solo la instancia
## -wh. Una consulta paginada por tipo cada ~10 min.
#WEBHOOK_VERIFY_ACTIVE_SWEEP_ENABLED=false
#WEBHOOK_VERIFY_ACTIVE_SWEEP_CRON="5,15,25,35,45,55 * * * *"
#WEBHOOK_VERIFY_ACTIVE_SWEEP_TYPES=unreachable
#WEBHOOK_VERIFY_ACTIVE_SWEEP_MAX_PAGES=5
## Solo entran alertas iniciadas dentro de esta ventana respecto a la activa
## más nueva (default 24 h). Evita importar alertas viejas que Meraki dejó abiertas.
#WEBHOOK_VERIFY_ACTIVE_SWEEP_WINDOW_MS=86400000

## Frecuencia del polling de la instancia de producción (default 1 y 3 min).
## Espaciarlo reduce 429 cuando -wh cubre la detección por webhook.
#ACTIVE_CRON="*/1 * * * *"
#CESE_CRON="*/3 * * * *"

## Aprovisionamiento masivo de webhooks (POST /admin/meraki/webhook-provisioning/*).
## Por defecto, esta instancia SOLO puede aprovisionar su propia organización
## (ORGANIZATION_ID) -- organizationSelector.mode:"all"/"organizationIds" con
## otra organización se rechaza. Dejar en false/sin definir para MEP (7
## instancias, una por organización, mismo TOKEN_CISCO compartido tipo MSP).
## Poner en "true" solo si esta instancia en particular debe administrar
## varias organizaciones Meraki desde un único despliegue.
#WEBHOOK_PROVISIONING_ALLOW_CROSS_ORG=false

## Ceses -- endpoint separado POST /webhooks/meraki/ceses, mismo shared
## secret de arriba.
#WEBHOOK_CESES_CONCURRENCY=3

## --- Apagar el envío a ms-helix-tcp (solo instancias que NO deben tocar Helix) ---
## Default true. En false se omite el POST a URL_TCP_SERVER y las alertas se
## marcan como enviadas igual. Pensado para ms-helix-mep-wh (solo Epistech).
## NUNCA en false en la instancia de producción.
#TCP_ENABLED=true

## --- Silencio por tipo: polling como RESPALDO (no alerta, pero sigue funcionando) ---
## Las alertas de TCP_SILENT_TYPES CREADAS desde TCP_SILENT_FROM se guardan y
## se cierran normalmente pero NO se envían a Helix ni a Epistech (se marcan
## como enviadas sin enviar). Las anteriores a esa fecha siguen enviando su
## cese con normalidad. TCP_SILENT_FROM es obligatoria (ISO, hora de ESTE
## servidor: usar `date -u +%Y-%m-%dT%H:%M:%SZ` en el momento de activarlo);
## sin ella no se silencia nada.
## Para ACTIVAR el respaldo (que vuelvan a alertar): quitar ambas variables y
## re-marcar como pendientes las abiertas que se silenciaron:
##   db.alerts.updateMany({type:"unreachable", resolvedAt:null, isTcp:true,
##     createdAt:{$gte:ISODate("<TCP_SILENT_FROM>")}}, {$set:{isTcp:false}})
#TCP_SILENT_TYPES=unreachable
#TCP_SILENT_FROM=2026-10-06T13:00:00Z

## --- Reenvío a EPISTECH (EpistechWebHook) ---
## Envía en paralelo a TCP el mismo payload (caídas + ceses) que ya recibe
## ms-helix-tcp. Apagado por defecto (EPISTECH_WEBHOOK_ENABLED=false) hasta
## que el receptor del lado de Epistech esté listo para procesar datos
## reales -- hoy (sep-2026) solo los guarda crudos en una tabla de log.
## EPISTECH_WEBHOOK_URL debe ser la URL COMPLETA del endpoint (incluye el
## path, ej. http://<host>:4000/webhook/receive), no solo el host.
## EPISTECH_WEBHOOK_TOKEN es opcional -- EpistechWebHook trae un middleware
## de JWT ya escrito pero no aplicado a esa ruta todavía; se manda igual si
## está configurado, para no tener que volver a tocar este servicio cuando
## lo activen del otro lado.

#EPISTECH_WEBHOOK_ENABLED=false
#EPISTECH_WEBHOOK_URL="http://localhost:4000/webhook/receive"
#EPISTECH_WEBHOOK_TOKEN=
#EPISTECH_WEBHOOK_TIMEOUT_MS=5000
#EPISTECH_WEBHOOK_CONCURRENCY=2
