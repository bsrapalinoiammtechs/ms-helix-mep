# Plantilla de configuración de ms-helix-mep. Copiar a `.env` en cada
# carpeta de organización y completar los valores reales -- `.env` NO se
# trackea en git (ver .gitignore); esta plantilla sí.

## --- Específico de cada organización (obligatorio, sin default) ---

# Identificador corto de esta organización (minúsculas, sin espacios).
# docker-compose.yml lo usa para nombrar contenedores: mongodb-helix-<org>,
# redis-helix-<org>, ms-helix-<org>. Debe ser único por organización en
# este host -- es lo único que evita choques de nombre entre carpetas.
ORG_SLUG=

# Conexión a MongoDB. El nombre del servicio Mongo dentro de la red de
# docker-compose es fijo ("mongodb-helix"), no depende de ORG_SLUG:
# mongodb://andrair:1234@mongodb-helix:27017/ms_helix_<org>?authSource=admin
MONGO_DB=

# Puerto HTTP donde escucha esta instancia -- también se usa para publicar
# el puerto al host en docker-compose.yml (misma variable en ambos lados,
# no hace falta mantenerlos sincronizados a mano)
HTTP_PORT=

# Puertos publicados al host para acceso directo a Mongo/Redis desde fuera
# del contenedor (debugging). Deben ser únicos por organización en este
# host -- todas las organizaciones comparten el mismo host físico.
MONGO_LOCAL_PORT=
REDIS_LOCAL_PORT=

# Nombre REAL del volumen de Docker donde vive la base de esta
# organización -- OBLIGATORIO, sin default seguro posible. Verificar con
# `docker volume ls | grep <org>` el nombre exacto que YA existe antes de
# levantar; si se pone un nombre que no existe, Docker crea uno nuevo
# vacío en su lugar (sin avisar) -- exactamente el incidente de datos del
# 2026-08-24, dos veces en el mismo día. Ante la duda, confirmarlo con
# `docker volume ls` primero, nunca adivinarlo.
MONGO_VOLUME_NAME=

# Organización de Meraki
ORGANIZATION_ID=
ORGANIZATION_NAME=

# Token de la API de Meraki para ESTA organización (cada organización debe
# tener su propio token -- no reutilizar entre organizaciones)
TOKEN_CISCO=

# GLPI de esta organización
URL_GLPI=
APP_TOKEN_GLPI=
AUTHORIZATION_GLPI=

# ms-helix-tcp de esta organización (destino de los envíos al NMS Helix)
URL_TCP_SERVER=

## --- Campos fijos del envío a Helix (rara vez cambian por organización) ---

TIPO_ALERTA="ALARMA"
FASE_ALERTA="FASE1"

## --- Gateway de rate-limit hacia Meraki (BullMQ) -- Fase D ---

# Redis PROPIO de esta organización -- no compartir entre organizaciones.
# En docker-compose esto lo sobreescribe la variable `environment:` del
# servicio ms-helix (ver docker-compose.yml), así que este valor solo
# aplica corriendo local sin Docker (npm start). dotenv NO interpola
# variables entre sí -- escribir el puerto real, no una referencia a
# REDIS_LOCAL_PORT:
REDIS_URL=redis://localhost:6380

# Espaciado mínimo entre llamadas reales a Meraki. 11000 (11s) es el valor
# validado empíricamente en mep3 -- ver 01_FIX_ALERTAS_RETENIDAS...md
# sección D.0: además del límite de 10 req/s por organización, Meraki
# aplica 100 req/s por IP de origen COMPARTIDO entre todas las
# organizaciones que salgan por esa IP. Si varias organizaciones corren en
# el mismo host, todas deben tener un valor conservador acá.
MERAKI_RATE_DELAY_MS=11000

# Cuánto espera el productor a que el worker resuelva un job antes de
# darlo por perdido (ms). Default generoso a propósito -- ver meraki.queue.ts
#MERAKI_JOB_WAIT_TIMEOUT_MS=600000

# Reintentos ante 429 dentro del worker, respetando Retry-After
#CISCO_429_MAX_RETRIES=5
#CISCO_429_DEFAULT_RETRY_SEC=10

# Dashboard /admin/queues (bull-board). Si se dejan vacías, la ruta
# responde 503 en vez de quedar sin autenticación (fail-closed).
BULLBOARD_USER=
BULLBOARD_PASSWORD=

## --- Paginación de active/cese (rara vez hace falta tocar) ---

#CISCO_PAGE_DELAY_MS=5000
#CISCO_MAX_ALERTS=10000
#CISCO_MAX_PAGES=20

## --- Apagar polling contra Meraki sin parar el contenedor (desarrollo/pruebas) ---
## Pensado para cuando el .env tiene credenciales REALES de producción pero
## se quiere probar algo local (ej. el webhook receptor, Fase C) sin que
## esta instancia compita por el rate-limit compartido con la instancia
## real. Default true en ambos -- no cambia nada en producción a menos que
## se seteen explícitamente en false.

#ACTIVE_ENABLED=true
#CESE_ENABLED=true

## --- Reconciliación periódica (cron interno, Fase B1/B5) ---

#RECONCILIATION_ENABLED=true
#RECONCILIATION_CRON="7 * * * *"
#RECONCILIATION_MAX_AGE_DAYS=30
#RECONCILIATION_RATE_DELAY_MS=11000
#RECONCILIATION_STUCK_HOURS=1
#RECONCILIATION_MAX_NETWORKS=999
#RECONCILIATION_MAX_PAGES_PER_NETWORK=8
#RECONCILIATION_DRY_RUN=false

## --- Backfill único del histórico atascado (Fase E, script standalone) ---
## No las lee el cron normal -- solo `npm run backfill:reconciliation`
## (src/scripts/backfillReconciliation.ts). Requiere que el contenedor ya
## esté corriendo (usa el Worker de meraki.queue que ya vive ahí).

#BACKFILL_MAX_AGE_DAYS=3650
#BACKFILL_DRY_RUN=true

## --- Webhook de Meraki (Fase C, en construcción) ---
## Receptor en POST /webhooks/meraki/alerts. El shared secret viaja DENTRO
## del body JSON que manda Meraki (campo `sharedSecret`), no como header --
## debe coincidir con el que se configure en Meraki al registrar el HTTP
## server receptor. Sin esta variable, el endpoint responde 503 (fail closed).

#MERAKI_WEBHOOK_SHARED_SECRET=
#WEBHOOK_ALERTS_CONCURRENCY=3

## Ceses -- endpoint separado POST /webhooks/meraki/ceses, mismo shared
## secret de arriba.
#WEBHOOK_CESES_CONCURRENCY=3

## --- Reenvío a EPISTECH (EpistechWebHook) ---
## Envía en paralelo a TCP el mismo payload (caídas + ceses) que ya recibe
## ms-helix-tcp. Apagado por defecto (EPISTECH_WEBHOOK_ENABLED=false) hasta
## que el receptor del lado de Epistech esté listo para procesar datos
## reales -- hoy (sep-2026) solo los guarda crudos en una tabla de log.
## EPISTECH_WEBHOOK_URL debe ser la URL COMPLETA del endpoint (incluye el
## path, ej. http://<host>:4000/webhook/receive), no solo el host.
## EPISTECH_WEBHOOK_TOKEN es opcional -- EpistechWebHook trae un middleware
## de JWT ya escrito pero no aplicado a esa ruta todavía; se manda igual si
## está configurado, para no tener que volver a tocar este servicio cuando
## lo activen del otro lado.

#EPISTECH_WEBHOOK_ENABLED=false
#EPISTECH_WEBHOOK_URL="http://localhost:4000/webhook/receive"
#EPISTECH_WEBHOOK_TOKEN=
#EPISTECH_WEBHOOK_TIMEOUT_MS=5000
#EPISTECH_WEBHOOK_CONCURRENCY=2
