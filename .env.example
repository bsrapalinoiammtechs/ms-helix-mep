# Plantilla de configuración de ms-helix-mep. Copiar a `.env` en cada
# carpeta de organización y completar los valores reales -- `.env` NO se
# trackea en git (ver .gitignore); esta plantilla sí.

## --- Específico de cada organización (obligatorio, sin default) ---

# Conexión a MongoDB. En producción (docker-compose) usa el nombre del
# servicio Mongo de ESTA organización, ej:
# mongodb://andrair:1234@mongodb-helix-<org>:27017/ms_helix_<org>?authSource=admin
MONGO_DB=

# Puerto HTTP donde escucha esta instancia (debe matchear el puerto
# publicado para esta organización en docker-compose.yml)
HTTP_PORT=

# Organización de Meraki
ORGANIZATION_ID=
ORGANIZATION_NAME=

# Token de la API de Meraki para ESTA organización (cada organización debe
# tener su propio token -- no reutilizar entre organizaciones)
TOKEN_CISCO=

# GLPI de esta organización
URL_GLPI=
APP_TOKEN_GLPI=
AUTHORIZATION_GLPI=

# ms-helix-tcp de esta organización (destino de los envíos al NMS Helix)
URL_TCP_SERVER=

## --- Campos fijos del envío a Helix (rara vez cambian por organización) ---

TIPO_ALERTA="ALARMA"
FASE_ALERTA="FASE1"

## --- Gateway de rate-limit hacia Meraki (BullMQ) -- Fase D ---

# Redis PROPIO de esta organización (docker-compose crea un servicio
# redis-helix-<org> dedicado -- no compartir entre organizaciones)
REDIS_URL=redis://redis-helix-<org>:6379

# Espaciado mínimo entre llamadas reales a Meraki. 11000 (11s) es el valor
# validado empíricamente en mep3 -- ver 01_FIX_ALERTAS_RETENIDAS...md
# sección D.0: además del límite de 10 req/s por organización, Meraki
# aplica 100 req/s por IP de origen COMPARTIDO entre todas las
# organizaciones que salgan por esa IP. Si varias organizaciones corren en
# el mismo host, todas deben tener un valor conservador acá.
MERAKI_RATE_DELAY_MS=11000

# Cuánto espera el productor a que el worker resuelva un job antes de
# darlo por perdido (ms). Default generoso a propósito -- ver meraki.queue.ts
#MERAKI_JOB_WAIT_TIMEOUT_MS=600000

# Reintentos ante 429 dentro del worker, respetando Retry-After
#CISCO_429_MAX_RETRIES=5
#CISCO_429_DEFAULT_RETRY_SEC=10

# Dashboard /admin/queues (bull-board). Si se dejan vacías, la ruta
# responde 503 en vez de quedar sin autenticación (fail-closed).
BULLBOARD_USER=
BULLBOARD_PASSWORD=

## --- Paginación de active/cese (rara vez hace falta tocar) ---

#CISCO_PAGE_DELAY_MS=5000
#CISCO_MAX_ALERTS=10000
#CISCO_MAX_PAGES=20

## --- Reconciliación periódica (cron interno, Fase B1/B5) ---

#RECONCILIATION_ENABLED=true
#RECONCILIATION_CRON="7 * * * *"
#RECONCILIATION_MAX_AGE_DAYS=30
#RECONCILIATION_RATE_DELAY_MS=11000
#RECONCILIATION_STUCK_HOURS=1
#RECONCILIATION_MAX_NETWORKS=999
#RECONCILIATION_MAX_PAGES_PER_NETWORK=8
#RECONCILIATION_DRY_RUN=false
